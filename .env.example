# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Session signing -------------------------------------------------------
# SESSION_SECRET signs the HttpOnly session cookie that stores the Deriv OAuth
# access token + the redacted user identity. MUST be set in production to a
# 32+ byte random string (e.g. `openssl rand -hex 32`). When unset in
# development a random ephemeral key is used (sessions invalidate on restart).
SESSION_SECRET=

# --- Real trading gate (FIX 1, ZT-01/ZT-02) --------------------------------
# When "false" (the default), the /api/mt5/trade route rejects real-account
# orders with HTTP 403 and a clear error message. Set to "true" to allow real
# money execution. Demo and paper trades are always allowed.
REAL_TRADING_ENABLED=false

# --- Owner gating (FIX 1) --------------------------------------------------
# The ZT_OWNER_USER_ID env var restricts the /api/mt5/connect (provisioning)
# route to a single owner. When unset, the route is open to any authenticated
# user (sufficient for single-user dev deployments). Set to the session
# userId (Deriv loginid or MT5-login label) of the owner in production.
ZT_OWNER_USER_ID=

# Deriv OAuth2 (register the exact redirect URI in your Deriv app)
DERIV_CLIENT_ID=your-deriv-client-id
DERIV_REDIRECT_URI=http://localhost:3000/api/auth/deriv/callback

# MetaTrader 5 (Equiti Brokerage)
# These are server-side only (do NOT prefix with NEXT_PUBLIC_). They are read
# by the /api/mt5/* routes when provisioning the MetaApi account.
MT5_LOGIN=your-mt5-login-number
MT5_SERVER=EquitiBrokerageSC-Live
MT5_PASSWORD=your-mt5-password
MT5_ACCOUNT_TYPE=real

# Optional: expose the login + server to the client bundle so the sidebar
# badge shows them on MetaTrader logins. Safe to leave blank — the sidebar
# will fall back to a generic "MT5-account" label.
NEXT_PUBLIC_MT5_LOGIN=1013266481
NEXT_PUBLIC_MT5_SERVER=EquitiBrokerageSC-Live

# MetaApi.cloud (for MT5 integration)
# Create a free account at https://metaapi.cloud, then copy your API token
# from the profile page. Provision your MT5 account once via
# POST /api/mt5/connect { login, password, server } (requires admin session)
# and copy the returned accountId here. Once both vars are set, the sidebar
# balance + open positions + trade placement routes are live.
METAAPI_TOKEN=your-metaapi-token
MT5_ACCOUNT_ID=your-metaapi-account-id
