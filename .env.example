# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deriv OAuth2 (register the exact redirect URI in your Deriv app)
DERIV_CLIENT_ID=your-deriv-client-id
DERIV_REDIRECT_URI=http://localhost:3000/api/auth/deriv/callback

# MetaTrader 5 (Equiti Brokerage)
MT5_LOGIN=your-mt5-login-number
MT5_SERVER=EquitiBrokerageSC-Live
MT5_PASSWORD=your-mt5-password
MT5_ACCOUNT_TYPE=real
MT5_INITIAL_BALANCE=10.98
