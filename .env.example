# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deriv OAuth2 (register the exact redirect URI in your Deriv app)
DERIV_CLIENT_ID=your-deriv-client-id
DERIV_REDIRECT_URI=http://localhost:3000/api/auth/deriv/callback

# MetaTrader 5 (Equiti Brokerage)
# These are server-side only (do NOT prefix with NEXT_PUBLIC_). They are read
# by the /api/mt5/* routes when provisioning the MetaApi account.
MT5_LOGIN=your-mt5-login-number
MT5_SERVER=EquitiBrokerageSC-Live
MT5_PASSWORD=your-mt5-password
MT5_ACCOUNT_TYPE=real

# Real-account initial balance shown in the sidebar before the first upstream
# fetch resolves. Use the NEXT_PUBLIC_ prefixed version so the value is
# inlined into the client bundle at build time. The non-prefixed form is also
# read as a fallback (for deploys that only set the server-side var).
NEXT_PUBLIC_MT5_INITIAL_BALANCE=10.98
MT5_INITIAL_BALANCE=10.98

# Optional: also expose the login + server to the client bundle so the
# sidebar badge shows them on MetaTrader logins. Safe to leave blank — the
# sidebar will fall back to a generic "MT5-account" label.
NEXT_PUBLIC_MT5_LOGIN=1013266481
NEXT_PUBLIC_MT5_SERVER=EquitiBrokerageSC-Live

# MetaApi.cloud (for MT5 integration)
# Create a free account at https://metaapi.cloud, then copy your API token
# from the profile page. Provision your MT5 account once via
# POST /api/mt5/connect { login, password, server } and copy the returned
# accountId here. Once both vars are set, the sidebar balance + open
# positions + trade placement routes are live.
METAAPI_TOKEN=your-metaapi-token
MT5_ACCOUNT_ID=your-metaapi-account-id
